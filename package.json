{
  "name": "luach",
  "version": "0.1.0",
  "description": "Hebrew calendar, holidays, parsha, learning cycles and zmanim. Clean-room, zero dependencies, Apache-2.0.",
  "keywords": [
    "hebrew calendar",
    "jewish calendar",
    "luach",
    "zmanim",
    "parsha",
    "daf yomi",
    "holidays",
    "sunrise",
    "sunset"
  ],
  "license": "Apache-2.0",
  "author": "Yosef Skolnick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yskolnick/luach.git"
  },
  "bugs": {
    "url": "https://github.com/yskolnick/luach/issues"
  },
  "homepage": "https://github.com/yskolnick/luach#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./places-full": {
      "import": {
        "types": "./dist/places-full.d.ts",
        "default": "./dist/places/full.js"
      },
      "require": {
        "types": "./dist/places-full.d.cts",
        "default": "./dist/places-full.cjs"
      }
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:imports && npm run check:licenses && npm run build && npm test && npm run check:size",
    "test:hermes": "node scripts/hermes-test.mjs",
    "docs:api": "typedoc",
    "docs:gen": "node scripts/gen-halacha-docs.mjs",
    "docs:build": "npm run build && npm run docs:api && npm run docs:gen && vitepress build docs",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:check": "node scripts/render-docs.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@hebcal/core": "^6.14.6",
    "@hebcal/learning": "^6.12.2",
    "@hebcal/leyning": "^10.1.0",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "astronomy-engine": "^2.1.19",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "fast-check": "^3.23.2",
    "ical.js": "^2.2.1",
    "kosher-zmanim": "^0.9.0",
    "playwright": "^1.64.1",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7"
  },
  "bin": {
    "luach": "./dist/cli/cli.js"
  }
}
