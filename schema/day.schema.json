{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yskolnick/luach/schema/day.schema.json",
  "title": "Luach day",
  "description": "Everything about one civil date at one place, as returned by luach's getDay(). Ask your rav: this data calculates; it does not rule.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gregorian",
    "dayOfWeek",
    "hebrew",
    "calendar",
    "location",
    "holidays",
    "parsha",
    "omer",
    "hallel",
    "rainPrayers",
    "molad",
    "zmanim",
    "candleLighting",
    "havdala",
    "fast",
    "learning"
  ],
  "$defs": {
    "zman": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "local",
        "opinion",
        "source",
        "rounded"
      ],
      "properties": {
        "time": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "ISO 8601 instant (UTC), or null if the sun doesn't reach the angle that day."
        },
        "local": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-2][0-9]:[0-5][0-9]$",
          "description": "Wall-clock time in the location's zone."
        },
        "opinion": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "rounded": {
          "enum": [
            "up",
            "down",
            "none"
          ]
        },
        "reason": {
          "enum": [
            "sun-always-above",
            "sun-always-below"
          ]
        },
        "fallback": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "gregorian": {
      "type": "string",
      "pattern": "^-?[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dayOfWeek": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "description": "0 = Sunday … 6 = Shabbos"
    },
    "hebrew": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "month",
        "day",
        "text",
        "textHebrew"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 13,
          "description": "Counted from Nisan = 1; Adar II = 13"
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "text": {
          "type": "string"
        },
        "textHebrew": {
          "type": "string"
        }
      }
    },
    "calendar": {
      "enum": [
        "israel",
        "diaspora"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude",
        "elevation",
        "timeZone"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevation": {
          "type": "number"
        },
        "timeZone": {
          "type": "string",
          "description": "IANA time-zone id"
        }
      }
    },
    "holidays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "yomTov",
          "fast"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "yom-tov",
              "chol-hamoed",
              "fast",
              "rosh-chodesh",
              "rabbinic",
              "minor",
              "special-shabbos",
              "shabbos-mevorchim",
              "erev",
              "isru-chag",
              "modern-israeli",
              "custom"
            ]
          },
          "yomTov": {
            "type": "boolean"
          },
          "fast": {
            "enum": [
              "major",
              "minor",
              null
            ]
          },
          "candlesTonight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        }
      }
    },
    "parsha": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shabbos",
        "name",
        "parsha",
        "special"
      ],
      "properties": {
        "shabbos": {
          "type": "string",
          "description": "The Shabbos (on or after this date) the reading is for"
        },
        "name": {
          "type": "string"
        },
        "parsha": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "maxItems": 2
        },
        "special": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "omer": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "day",
        "textHebrew",
        "textEnglish",
        "sefirah"
      ],
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 49
        },
        "textHebrew": {
          "type": "string"
        },
        "textEnglish": {
          "type": "string"
        },
        "sefirah": {
          "type": "string"
        }
      }
    },
    "hallel": {
      "enum": [
        "whole",
        "half",
        null
      ]
    },
    "rainPrayers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mashivHaruach",
        "talUmatar",
        "changeAtMusaf"
      ],
      "properties": {
        "mashivHaruach": {
          "type": "boolean"
        },
        "talUmatar": {
          "type": "boolean"
        },
        "changeAtMusaf": {
          "enum": [
            "start-geshem",
            "stop-geshem",
            null
          ]
        }
      }
    },
    "molad": {
      "type": [
        "string",
        "null"
      ]
    },
    "zmanim": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/zman"
      }
    },
    "candleLighting": {
      "oneOf": [
        {
          "$ref": "#/$defs/zman"
        },
        {
          "type": "null"
        }
      ]
    },
    "havdala": {
      "oneOf": [
        {
          "$ref": "#/$defs/zman"
        },
        {
          "type": "null"
        }
      ]
    },
    "fast": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "begins",
            "ends"
          ],
          "properties": {
            "begins": {
              "$ref": "#/$defs/zman"
            },
            "ends": {
              "$ref": "#/$defs/zman"
            }
          }
        }
      ]
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dafYomi",
        "yerushalmi",
        "mishnaYomis",
        "rambam3",
        "rambam1",
        "nachYomi",
        "dafHaShavua"
      ],
      "properties": {
        "dafYomi": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "textHebrew"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "textHebrew": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "yerushalmi": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "textHebrew"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "textHebrew": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "mishnaYomis": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "textHebrew"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "textHebrew": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "rambam3": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "textHebrew"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "textHebrew": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "rambam1": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "textHebrew"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "textHebrew": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "nachYomi": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "textHebrew"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "textHebrew": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "dafHaShavua": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "textHebrew"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "textHebrew": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    }
  }
}
