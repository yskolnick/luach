{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yskolnick/luach/v0.5.0/schema/day.schema.json",
  "title": "Luach day",
  "description": "Everything about one day, as returned by dayInfo() in the luach package. Times are ISO 8601 UTC instants with a local HH:MM in the location's zone. Every zman names its opinion and source; defaults are not rulings. Fields may be added in later versions; a reader should ignore fields it does not know.",
  "type": "object",
  "required": [
    "$schema",
    "date",
    "weekday",
    "weekdayName",
    "hebrewDate",
    "israel",
    "events",
    "shabbos",
    "yomTov",
    "melachaForbidden",
    "fastKind",
    "followedBy",
    "eruvTavshilin",
    "erev",
    "parsha",
    "haftara",
    "omer",
    "tefillah",
    "learning",
    "learningDetail",
    "location",
    "zmanim",
    "candleLighting",
    "havdala",
    "shabbosEnds",
    "fast",
    "fastBeginsTonight"
  ],
  "$defs": {
    "zman": {
      "type": "object",
      "required": [
        "id",
        "time",
        "local",
        "offset",
        "rounded"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "time": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "The time, rounded to the minute on the safe side (earliest times up, deadlines down): safe to display by truncating. Null when it does not occur (see reason)."
        },
        "exact": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "The exact instant, to the millisecond on the safe side. For calculation, not display."
        },
        "local": {
          "type": [
            "string",
            "null"
          ],
          "description": "The wall-clock time only (HH:MM) at the location, with no date: a time can fall on a different civil day from the one asked about. Compare time (the instant), not local."
        },
        "offset": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[+-][0-9]{2}:[0-9]{2}$",
          "description": "The location's offset from UTC at this time (ISO 8601, e.g. -05:00), so local and offset give the full local time; null with no time."
        },
        "timeZone": {
          "type": "string",
          "description": "Left out in a compact document (see sources)."
        },
        "opinion": {
          "type": "string",
          "description": "Left out in a compact document (see sources)."
        },
        "source": {
          "type": "string",
          "description": "Left out in a compact document (see sources)."
        },
        "rounded": {
          "enum": [
            "up",
            "down",
            null
          ]
        },
        "reason": {
          "enum": [
            "sun-always-above",
            "sun-always-below",
            "no-sunrise",
            "no-sunset",
            "depends-on-missing-zman",
            "not-applicable-today",
            "requires-terrain-data"
          ]
        },
        "fallback": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "earliest",
            "deadline"
          ],
          "description": "An earliest time (rounded up for display) or a deadline (rounded down)."
        },
        "slot": {
          "type": "string",
          "description": "The kind of time: alos, shema, tzeis, candleLighting, havdala, fast and so on."
        },
        "fallbacks": {
          "type": "object",
          "description": "Where time is null because the sun does not get low enough (reason sun-always-above), what each high-latitude rule gives: halfNight (solar midnight) and nearestDay. Neither is used unless chosen; which applies is a question for a rav.",
          "required": [
            "halfNight",
            "nearestDay"
          ],
          "properties": {
            "halfNight": {
              "$ref": "#/$defs/zman"
            },
            "nearestDay": {
              "$ref": "#/$defs/zman"
            }
          }
        }
      }
    },
    "flags": {
      "type": "object",
      "required": [
        "yomTov",
        "melachaForbidden",
        "cholHamoed",
        "fast",
        "roshChodesh",
        "modernIsraeli",
        "minor",
        "specialShabbos",
        "erev",
        "isruChag",
        "optional"
      ],
      "properties": {
        "yomTov": {
          "type": "boolean"
        },
        "melachaForbidden": {
          "type": "boolean"
        },
        "cholHamoed": {
          "type": "boolean"
        },
        "roshChodesh": {
          "type": "boolean"
        },
        "modernIsraeli": {
          "type": "boolean"
        },
        "minor": {
          "type": "boolean"
        },
        "specialShabbos": {
          "type": "boolean"
        },
        "erev": {
          "type": "boolean"
        },
        "isruChag": {
          "type": "boolean"
        },
        "optional": {
          "type": "boolean"
        },
        "fast": {
          "enum": [
            "major",
            "minor",
            null
          ]
        }
      }
    },
    "learningPortion": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "text",
        "cycle",
        "cycleNumber",
        "day",
        "length"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "cycle": {
          "type": "string"
        },
        "cycleNumber": {
          "type": "integer",
          "minimum": 1
        },
        "day": {
          "type": "integer",
          "minimum": 1
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "tractate": {
          "type": "string"
        },
        "tractateHe": {
          "type": "string"
        },
        "daf": {
          "type": "integer",
          "minimum": 2
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://raw.githubusercontent.com/yskolnick/luach/v0.5.0/schema/day.schema.json",
      "description": "The $id of this schema."
    },
    "date": {
      "type": "string",
      "pattern": "^[+-]?\\d{4,6}-\\d{2}-\\d{2}$"
    },
    "weekday": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "description": "0 = Sunday … 6 = Shabbos"
    },
    "weekdayName": {
      "type": "string"
    },
    "hebrewDate": {
      "type": "object",
      "required": [
        "year",
        "month",
        "day",
        "monthName",
        "formatted"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 13,
          "description": "Nisan = 1 … Adar (Adar I) = 12, Adar II = 13"
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "monthName": {
          "type": "string"
        },
        "formatted": {
          "type": "string"
        }
      }
    },
    "israel": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "flags",
          "begins"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "flags": {
            "$ref": "#/$defs/flags"
          },
          "begins": {
            "enum": [
              "sunset",
              "dawn"
            ],
            "description": "When the event's day begins: sunset (the evening before), or dawn for a minor fast."
          },
          "day": {
            "type": "integer"
          },
          "candlesTonight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "moved": {
            "type": "boolean"
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13,
            "description": "Rosh Chodesh, Shabbos Mevorchim, Yom Kippur Katan: the month concerned (1 = Nisan)."
          },
          "monthYear": {
            "type": "integer",
            "description": "The Hebrew year of month."
          }
        }
      }
    },
    "shabbos": {
      "type": "boolean",
      "description": "The day is Shabbos."
    },
    "yomTov": {
      "type": "boolean",
      "description": "One of the day's events is a Yom Tov where it is kept (Israel or the diaspora, as israel); Yom Kippur counts."
    },
    "melachaForbidden": {
      "type": "boolean",
      "description": "Melacha is forbidden on this day: Shabbos, Yom Tov or Yom Kippur."
    },
    "fastKind": {
      "enum": [
        "major",
        "minor",
        null
      ],
      "description": "The day's fast: major (Yom Kippur, Tisha B'Av: from sunset), minor (from dawn), or null."
    },
    "followedBy": {
      "description": "What the next day is, on every day, including a day that is itself Shabbos or Yom Tov: shabbos, then yom-kippur or yom-tov (a Yom Tov on which melacha is forbidden, for the day's Israel or diaspora setting). Usually empty.",
      "type": "array",
      "items": {
        "enum": [
          "shabbos",
          "yom-tov",
          "yom-kippur"
        ]
      }
    },
    "eruvTavshilin": {
      "type": "boolean",
      "description": "An eruv tavshilin is made today: the day is not itself Shabbos or Yom Tov, and the Yom Tov that begins tonight runs into a Friday, its first or second day (Shulchan Aruch OC 527:1; Mishna Berura 527:1). By the day's Israel or diaspora setting."
    },
    "erev": {
      "description": "The eve of Shabbos and/or of a Yom Tov, as a fact about this civil day: the day is not itself Shabbos or a Yom Tov on which melacha is forbidden (Yom Kippur counts), and the next day is Shabbos (erev-shabbos) and/or such a Yom Tov for the day's Israel or diaspora setting (erev-yom-tov). Both can apply, erev-shabbos first. Usually empty. A day that is itself Shabbos or Yom Tov is always empty, even when another holy day follows: that case is left out. The eve of Yom Kippur has erev-yom-kippur only, never erev-yom-tov (the sources name that day \"Erev Yom Kippur\"), named as the day's own event is; erev-shabbos still comes first when Yom Kippur falls on Shabbos. It says nothing about candle lighting (see candleLighting); name is the everyday word in the locale asked for.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "enum": [
              "erev-shabbos",
              "erev-yom-tov",
              "erev-yom-kippur"
            ]
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "parsha": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "date",
        "ids",
        "name"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "holiday": {
          "type": "string"
        }
      }
    },
    "haftara": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "key",
        "reference"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "omer": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "day",
        "text",
        "textEnglish",
        "sefirah"
      ],
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 49
        },
        "text": {
          "type": "string"
        },
        "textEnglish": {
          "type": "string"
        },
        "sefirah": {
          "type": "string"
        }
      }
    },
    "tefillah": {
      "type": "object",
      "required": [
        "tachanun",
        "hallel",
        "yaalehVyavo",
        "alHanissim",
        "mizmorLesodah"
      ],
      "properties": {
        "tachanun": {
          "type": "boolean"
        },
        "hallel": {
          "enum": [
            "full",
            "half",
            null
          ]
        },
        "yaalehVyavo": {
          "type": "boolean"
        },
        "alHanissim": {
          "type": "boolean"
        },
        "mizmorLesodah": {
          "type": "boolean"
        }
      }
    },
    "learning": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "dafYomi",
            "yerushalmiYomi",
            "amudYomi",
            "mishnaYomis",
            "rambamOneChapter",
            "rambamThreeChapters",
            "nachYomi"
          ],
          "properties": {
            "dafYomi": {
              "type": [
                "string",
                "null"
              ]
            },
            "yerushalmiYomi": {
              "type": [
                "string",
                "null"
              ]
            },
            "amudYomi": {
              "type": [
                "string",
                "null"
              ]
            },
            "mishnaYomis": {
              "type": [
                "string",
                "null"
              ]
            },
            "rambamOneChapter": {
              "type": [
                "string",
                "null"
              ]
            },
            "rambamThreeChapters": {
              "type": [
                "string",
                "null"
              ]
            },
            "nachYomi": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "The daily learning (daf yomi, Yerushalmi, amud yomi, mishna yomis, Rambam, Nach yomi), or null. It is included only when the caller passes the learning plug-in: dayInfo(date, { learning: dayLearning }), with dayLearning from 'luach/learning'."
    },
    "learningDetail": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "dafYomi",
            "yerushalmiYomi",
            "amudYomi",
            "mishnaYomis",
            "rambamOneChapter",
            "rambamThreeChapters",
            "nachYomi"
          ],
          "properties": {
            "dafYomi": {
              "$ref": "#/$defs/learningPortion"
            },
            "yerushalmiYomi": {
              "$ref": "#/$defs/learningPortion"
            },
            "amudYomi": {
              "$ref": "#/$defs/learningPortion"
            },
            "mishnaYomis": {
              "$ref": "#/$defs/learningPortion"
            },
            "rambamOneChapter": {
              "$ref": "#/$defs/learningPortion"
            },
            "rambamThreeChapters": {
              "$ref": "#/$defs/learningPortion"
            },
            "nachYomi": {
              "$ref": "#/$defs/learningPortion"
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "The learning as data, by the same keys as learning: the text, the cycle, its number, the day within it and its length; for dafYomi also tractate, tractateHe and daf. Null without the learning plug-in."
    },
    "location": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "latitude",
        "longitude",
        "elevation",
        "timeZone"
      ],
      "description": "The place, for display. It does not carry the place's own candle-lighting custom or its id: to compute for the same place again, keep the Place object (or its id) you used, not this object.",
      "properties": {
        "name": {
          "type": "string"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevation": {
          "type": "number"
        },
        "timeZone": {
          "type": "string"
        }
      }
    },
    "zmanim": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zman"
      }
    },
    "candleLighting": {
      "oneOf": [
        {
          "$ref": "#/$defs/zman"
        },
        {
          "type": "null"
        }
      ]
    },
    "havdala": {
      "oneOf": [
        {
          "$ref": "#/$defs/zman"
        },
        {
          "type": "null"
        }
      ]
    },
    "shabbosEnds": {
      "description": "When Shabbos ends on a Shabbos whose havdala is deferred (Tisha B'Av postponed to Sunday); not havdala. Otherwise null.",
      "oneOf": [
        {
          "$ref": "#/$defs/zman"
        },
        {
          "type": "null"
        }
      ]
    },
    "fast": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id",
        "begins",
        "ends"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "begins": {
          "$ref": "#/$defs/zman"
        },
        "ends": {
          "$ref": "#/$defs/zman"
        }
      }
    },
    "fastBeginsTonight": {
      "description": "A fast that begins this evening at sunset (Yom Kippur, Tisha B'Av), or null.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id",
        "begins"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "begins": {
          "$ref": "#/$defs/zman"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "opinion",
          "source"
        ],
        "properties": {
          "opinion": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "description": "Only in a compact document (compactJson): each time's opinion and source by zman id, stated once. Its times then leave out opinion, source and timeZone (the location's)."
    }
  }
}
