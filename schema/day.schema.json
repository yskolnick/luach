{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yskolnick/luach/main/schema/day.schema.json",
  "title": "Luach day",
  "description": "Everything about one day, as returned by dayInfo() in the luach package. Times are ISO 8601 UTC instants with a local HH:MM in the location's zone. Every zman names its opinion and source; defaults are not rulings.",
  "type": "object",
  "required": [
    "$schema",
    "gregorian",
    "weekday",
    "weekdayName",
    "hebrew",
    "israel",
    "events",
    "erev",
    "parsha",
    "haftara",
    "omer",
    "tefillah",
    "learning",
    "location",
    "zmanim",
    "candleLighting",
    "havdala",
    "shabbosEnds",
    "fast",
    "fastBeginsTonight"
  ],
  "additionalProperties": false,
  "$defs": {
    "zman": {
      "type": "object",
      "required": [
        "id",
        "time",
        "local",
        "timeZone",
        "opinion",
        "source",
        "rounded"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "time": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "The time, rounded to the minute on the safe side (earliest times up, deadlines down): safe to display by truncating. Null when it does not occur (see reason)."
        },
        "exact": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "The exact instant, to the millisecond on the safe side. For calculation, not display."
        },
        "local": {
          "type": [
            "string",
            "null"
          ],
          "description": "The wall-clock time only (HH:MM) at the location, with no date: a time can fall on a different civil day from the one asked about. Compare time (the instant), not local."
        },
        "timeZone": {
          "type": "string"
        },
        "opinion": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "rounded": {
          "enum": [
            "up",
            "down",
            null
          ]
        },
        "reason": {
          "enum": [
            "sun-always-above",
            "sun-always-below",
            "no-sunrise",
            "no-sunset",
            "depends-on-missing-zman",
            "not-applicable-today",
            "requires-terrain-data"
          ]
        },
        "fallback": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "earliest",
            "deadline"
          ],
          "description": "An earliest time (rounded up for display) or a deadline (rounded down)."
        },
        "slot": {
          "type": "string",
          "description": "The kind of time: alos, shema, tzeis, candleLighting, havdala, fast and so on."
        }
      },
      "additionalProperties": false
    },
    "flags": {
      "type": "object",
      "required": [
        "yomTov",
        "melachaForbidden",
        "cholHamoed",
        "fast",
        "roshChodesh",
        "modernIsraeli",
        "minor",
        "specialShabbos",
        "erev",
        "isruChag",
        "optional"
      ],
      "properties": {
        "yomTov": {
          "type": "boolean"
        },
        "melachaForbidden": {
          "type": "boolean"
        },
        "cholHamoed": {
          "type": "boolean"
        },
        "roshChodesh": {
          "type": "boolean"
        },
        "modernIsraeli": {
          "type": "boolean"
        },
        "minor": {
          "type": "boolean"
        },
        "specialShabbos": {
          "type": "boolean"
        },
        "erev": {
          "type": "boolean"
        },
        "isruChag": {
          "type": "boolean"
        },
        "optional": {
          "type": "boolean"
        },
        "fast": {
          "enum": [
            "major",
            "minor",
            null
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://raw.githubusercontent.com/yskolnick/luach/main/schema/day.schema.json",
      "description": "The $id of this schema."
    },
    "gregorian": {
      "type": "string",
      "pattern": "^[+-]?\\d{4,6}-\\d{2}-\\d{2}$"
    },
    "weekday": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "description": "0 = Sunday … 6 = Shabbos"
    },
    "weekdayName": {
      "type": "string"
    },
    "hebrew": {
      "type": "object",
      "required": [
        "year",
        "month",
        "day",
        "monthName",
        "formatted"
      ],
      "additionalProperties": false,
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 13,
          "description": "Nisan = 1 … Adar (Adar I) = 12, Adar II = 13"
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "monthName": {
          "type": "string"
        },
        "formatted": {
          "type": "string"
        }
      }
    },
    "israel": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "flags"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "flags": {
            "$ref": "#/$defs/flags"
          },
          "day": {
            "type": "integer"
          },
          "candlesTonight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "moved": {
            "type": "boolean"
          }
        }
      }
    },
    "erev": {
      "description": "The eve of Shabbos and/or of a Yom Tov, as a fact about this civil day: the day is not itself Shabbos or a Yom Tov on which melacha is forbidden (Yom Kippur counts), and the next day is Shabbos (erev-shabbos) and/or such a Yom Tov for the day's Israel or diaspora setting (erev-yom-tov). Both can apply, erev-shabbos first. Usually empty. A day that is itself Shabbos or Yom Tov is always empty, even when another holy day follows: that case is left out. The eve of Yom Kippur has erev-yom-kippur only, never erev-yom-tov (the sources name that day \"Erev Yom Kippur\"), named as the day's own event is; erev-shabbos still comes first when Yom Kippur falls on Shabbos. It says nothing about candle lighting (see candleLighting); name is the everyday word in the locale asked for.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "erev-shabbos",
              "erev-yom-tov",
              "erev-yom-kippur"
            ]
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "parsha": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "date",
        "ids",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string"
        },
        "ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "holiday": {
          "type": "string"
        }
      }
    },
    "haftara": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "key",
        "reference"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "omer": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "day",
        "text",
        "textEnglish",
        "sefirah"
      ],
      "additionalProperties": false,
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 49
        },
        "text": {
          "type": "string"
        },
        "textEnglish": {
          "type": "string"
        },
        "sefirah": {
          "type": "string"
        }
      }
    },
    "tefillah": {
      "type": "object",
      "required": [
        "tachanun",
        "hallel",
        "yaalehVyavo",
        "alHanissim",
        "mizmorLesodah"
      ],
      "additionalProperties": false,
      "properties": {
        "tachanun": {
          "type": "boolean"
        },
        "hallel": {
          "enum": [
            "full",
            "half",
            null
          ]
        },
        "yaalehVyavo": {
          "type": "boolean"
        },
        "alHanissim": {
          "type": "boolean"
        },
        "mizmorLesodah": {
          "type": "boolean"
        }
      }
    },
    "learning": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "dafYomi",
            "yerushalmiYomi",
            "amudYomi",
            "mishnaYomis",
            "rambamOneChapter",
            "rambamThreeChapters",
            "nachYomi"
          ],
          "additionalProperties": false,
          "properties": {
            "dafYomi": {
              "type": [
                "string",
                "null"
              ]
            },
            "yerushalmiYomi": {
              "type": [
                "string",
                "null"
              ]
            },
            "amudYomi": {
              "type": [
                "string",
                "null"
              ]
            },
            "mishnaYomis": {
              "type": [
                "string",
                "null"
              ]
            },
            "rambamOneChapter": {
              "type": [
                "string",
                "null"
              ]
            },
            "rambamThreeChapters": {
              "type": [
                "string",
                "null"
              ]
            },
            "nachYomi": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "The daily learning (daf yomi, Yerushalmi, amud yomi, mishna yomis, Rambam, Nach yomi), or null. It is included only when the caller passes the learning plug-in: dayInfo(date, { learning: dayLearning }), with dayLearning from 'luach/learning'."
    },
    "location": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "latitude",
        "longitude",
        "elevation",
        "timeZone"
      ],
      "description": "The place, for display. It does not carry the place's own candle-lighting custom or its id: to compute for the same place again, keep the Place object (or its id) you used, not this object.",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevation": {
          "type": "number"
        },
        "timeZone": {
          "type": "string"
        }
      }
    },
    "zmanim": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zman"
      }
    },
    "candleLighting": {
      "oneOf": [
        {
          "$ref": "#/$defs/zman"
        },
        {
          "type": "null"
        }
      ]
    },
    "havdala": {
      "oneOf": [
        {
          "$ref": "#/$defs/zman"
        },
        {
          "type": "null"
        }
      ]
    },
    "shabbosEnds": {
      "description": "When Shabbos ends on a Shabbos whose havdala is deferred (Tisha B'Av postponed to Sunday); not havdala. Otherwise null.",
      "oneOf": [
        {
          "$ref": "#/$defs/zman"
        },
        {
          "type": "null"
        }
      ]
    },
    "fast": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id",
        "begins",
        "ends"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "begins": {
          "$ref": "#/$defs/zman"
        },
        "ends": {
          "$ref": "#/$defs/zman"
        }
      }
    },
    "fastBeginsTonight": {
      "description": "A fast that begins this evening at sunset (Yom Kippur, Tisha B'Av), or null.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id",
        "begins"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "begins": {
          "$ref": "#/$defs/zman"
        }
      }
    }
  }
}
