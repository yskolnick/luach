{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/cities-full.ts"
  ],
  "out": "docs/api",
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "readme": "none",
  "excludeInternal": true,
  "excludePrivate": true,
  "hidePageHeader": true,
  "entryFileName": "index",
  "outputFileStrategy": "modules",
  "sanitizeComments": true,
  "tsconfig": "tsconfig.json",
  "name": "Luach API reference"
}
